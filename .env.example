# Modelo do .env (fica na raiz, ao lado de manage.py). Copie para .env e preencha.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.

# Django
SECRET_KEY=
DEBUG=True
# Domínios extras, separados por vírgula. Exemplo: abc123.ngrok-free.app
ALLOWED_HOSTS=

# Banco de dados (Neon)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# E-mail. Sem EMAIL_HOST, o e-mail é impresso no terminal do runserver
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGEP <nao-responda@sigep.com.br>

# IA
GEMINI_API_KEY=

# Segredo das rotas internas de manutenção (/ia/manutencao/ e /telegram/manutencao/),
# enviado no cabeçalho X-Tarefas-Segredo. No App Engine, o cron do Telegram não precisa dele.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TAREFAS_SEGREDO=

# Fila das tarefas em segundo plano (leitura de documentos pela IA).
# imediata = roda no próprio servidor, logo depois de salvar (desenvolvimento)
# cloud_tasks = Cloud Tasks do Google (produção); precisa de TAREFAS_FILA e TAREFAS_SEGREDO
TAREFAS_BACKEND=imediata
# Exemplo: projects/meu-projeto/locations/southamerica-east1/queues/sigep
TAREFAS_FILA=

# Endereço público do site, sem barra no fim. Monta os links que o bot envia.
# Exemplo: https://meu-projeto.appspot.com
SITE_URL=

# Telegram
# Token que o @BotFather devolve no /newbot. É a senha mestra do bot.
TELEGRAM_BOT_TOKEN=
# Username do bot, sem o @, para montar os links t.me/. Exemplo: sigep_bot
TELEGRAM_BOT_USERNAME=
# URL pública HTTPS do webhook. Exemplo: https://abc123.ngrok-free.app/telegram/webhook/
TELEGRAM_BOT_WEBHOOK_URL=
# Frase aleatória que você inventa: de 1 a 256 caracteres, só letras, números, _ e -
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
